# Postgres (Docker) + Alembic — credenziali e configurazione
# Copia questo file in `.env` e modifica i valori prima di avviare il container.
# Il file `.env` e' letto automaticamente da docker compose (stessa directory).

POSTGRES_USER=taxidrivers
POSTGRES_PASSWORD=cambiami-con-una-password
POSTGRES_DB=taxidrivers
POSTGRES_PORT=5434
