# Postgres (Docker) + Alembic — credenziali e configurazione
# Copia questo file in `.env` e modifica i valori prima di avviare il container.
# Il file `.env` e' letto automaticamente da docker compose (stessa directory).

POSTGRES_USER=taxidrivers
POSTGRES_PASSWORD=cambiami-con-una-password
POSTGRES_DB=taxidrivers
POSTGRES_PORT=5437

# TMDB (scripts/trend_best_of.py): chiave gratuita da themoviedb.org -> Impostazioni -> API.
# Vanno bene sia la API Key v3 sia il Read Access Token v4.
TMDB_API_KEY=

# YouTube Data API v3 (views dei trailer): console.cloud.google.com -> API e servizi -> Credenziali -> chiave API.
# Quota gratuita 10.000 unita'/giorno; ogni ricerca ne costa 100.
YOUTUBE_API_KEY=
# Trakt (spettatori/visioni): trakt.tv/oauth/applications -> nuova app -> Client ID.
TRAKT_CLIENT_ID=
